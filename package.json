{
  "name": "paste-image-next",
  "displayName": "Paste Image Next",
  "description": "Paste a clipboard image into the project and insert a file reference.",
  "version": "0.1.0",
  "packageManager": "pnpm@12.1.0",
  "publisher": "gvastethecreator",
  "author": {
    "name": "gvastethecreator"
  },
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "private": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#111318",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/vscode-paste-image-next.git"
  },
  "bugs": {
    "url": "https://github.com/gvastethecreator/vscode-paste-image-next/issues"
  },
  "homepage": "https://github.com/gvastethecreator/vscode-paste-image-next#readme",
  "keywords": [
    "paste",
    "image",
    "clipboard",
    "screenshot",
    "assets"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage"
  ],
  "main": "./dist/node/extension.cjs",
  "browser": "./dist/web/extension.cjs",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "files": [
    "dist/node/extension.cjs",
    "dist/web/extension.cjs",
    "media/icon.png",
    "media/preview.png",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "Paste Image Next",
      "properties": {
        "pasteImageNext.destination": {
          "type": "string",
          "default": "${documentDir}/assets",
          "maxLength": 160,
          "scope": "resource",
          "description": "Asset directory. Use ${documentDir}, ${workspaceFolder}, or a document-relative path."
        },
        "pasteImageNext.filename": {
          "type": "string",
          "default": "image-${date}-${time}",
          "maxLength": 128,
          "scope": "resource",
          "description": "Image filename template. Supported tokens: ${date}, ${time}, ${documentName}, ${name}, and ${counter}."
        },
        "pasteImageNext.askForName": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Ask for a file name after this paste edit is selected."
        },
        "pasteImageNext.pathStyle": {
          "type": "string",
          "default": "documentRelative",
          "enum": [
            "documentRelative",
            "workspaceRelative"
          ],
          "enumDescriptions": [
            "Insert a path relative to the active document.",
            "Insert a slash-prefixed path relative to the active workspace folder."
          ],
          "scope": "resource",
          "description": "Path style for inserted image references."
        },
        "pasteImageNext.markdown.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Offer Paste Image Next during normal Markdown paste. VS Code's built-in Markdown image paste keeps priority."
        },
        "pasteImageNext.maximumFileSizeMiB": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100,
          "scope": "resource",
          "description": "Maximum accepted clipboard image size in mebibytes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && node esbuild.cjs",
    "watch": "node esbuild.cjs --watch",
    "package": "tsc --noEmit && node esbuild.cjs --production",
    "vsix": "vsce package --no-dependencies --out paste-image-next.vsix",
    "inspect:vsix": "node scripts/inspect-vsix.mjs paste-image-next.vsix",
    "check-types": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "node --test --experimental-strip-types src/**/*.test.ts",
    "test:performance": "node --experimental-strip-types scripts/performance.mjs",
    "render:media": "node scripts/render-media.mjs",
    "check:media": "node scripts/check-media.mjs",
    "test:integration": "node test/integration/run.mjs",
    "build:test-web": "node scripts/build-web-tests.mjs",
    "test:web": "pnpm run build:test-web && node test/web/run.mjs",
    "test:vsix": "node test/integration/run-vsix.mjs",
    "quality": "pnpm run test:unit && pnpm run check-types && pnpm run compile && pnpm run test:performance && pnpm run check:media"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@types/yauzl": "3.4.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "yauzl": "3.4.0"
  }
}
