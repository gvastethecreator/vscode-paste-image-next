{
  "name": "paste-image-next",
  "displayName": "Paste Image Next",
  "description": "Paste a clipboard image into the project and insert a file reference.",
  "version": "0.0.1",
  "packageManager": "pnpm@12.1.0",
  "publisher": "gvastethecreator",
  "author": {
    "name": "gvastethecreator"
  },
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/vscode-paste-image-next.git"
  },
  "bugs": {
    "url": "https://github.com/gvastethecreator/vscode-paste-image-next/issues"
  },
  "homepage": "https://github.com/gvastethecreator/vscode-paste-image-next#readme",
  "keywords": [
    "paste",
    "image",
    "clipboard",
    "screenshot",
    "assets"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "pasteImageNext.pasteImage",
        "title": "Paste Image",
        "category": "Paste Image Next"
      },
      {
        "command": "pasteImageNext.pasteImageAs",
        "title": "Paste Image As...",
        "category": "Paste Image Next"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && node esbuild.cjs",
    "watch": "node esbuild.cjs --watch",
    "package": "tsc --noEmit && node esbuild.cjs --production",
    "vsix": "pnpm run package && vsce package --no-dependencies",
    "check-types": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
